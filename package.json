{
  "name": "ticketshop",
  "version": "0.1.0",
  "private": false,
  "description": "Full-stack ticket shop with admin dashboard.",
  "author": "Marius Butz",
  "homepage": "https://github.com/mbpictures/ticketshop#readme",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "dev:test": "cross-env EMAIL_PROVIDER= EMAIL_HOST=localhost EMAIL_PORT=7777 next dev",
    "build": "next build",
    "vercel-build": "npm run copy-assets && prisma generate && next build",
    "copy-assets": "cp -r src/assets public/",
    "start": "next start",
    "start:default": "next start -p 3000",
    "start:test": "cross-env EMAIL_PROVIDER= EMAIL_HOST=localhost EMAIL_PORT=7777 nyc next start -p 3000",
    "heroku-postbuild": "prisma generate && prisma migrate reset --force --skip-seed && prisma db push && prisma db seed && next build",
    "prisma:generate": "prisma generate",
    "ngrok": "ngrok http 3000",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "validate:amounts": "npx ts-node scripts/validate-amounts.ts",
    "validate:monetary": "npx ts-node validate-monetary-consistency.js",
    "cleanup:data": "node data-cleanup-script.js",
    "cleanup:data:live": "DRY_RUN=false node data-cleanup-script.js",
    "lint": "next lint",
    "analyze": "set ANALYZE=true && npm run build",
    "seed:modern": "npx ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed-modern.ts && node scripts/seed-email-templates-modern.js",
    "seed:comprehensive": "node scripts/run-comprehensive-seed.js",
    "seed:emails-only": "node scripts/seed-email-templates-modern.js",
    "cypress:build": "prisma generate && prisma migrate reset --force --skip-seed && prisma db push && cross-env INSTRUMENT_CODE=true next build",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:run-ct": "cypress run --component --env INSTRUMENT_CODE=true",
    "cypress:cov": "npx nyc report --reporter=text-summary",
    "setup:jvs": "ts-node --transpile-only scripts/configure-jvs.ts",
    "migrate:jvs": "ts-node --transpile-only scripts/migrate-wp-events.ts",
    "migrate:images:test": "ts-node --transpile-only scripts/test-migration-setup.ts",
    "migrate:images:dry-run": "DRY_RUN=1 ts-node --transpile-only scripts/migrate-event-images.ts --limit 5",
    "migrate:images": "ts-node --transpile-only scripts/migrate-event-images.ts",
    "backfill-event-ticket-types": "ts-node --transpile-only scripts/backfill-event-ticket-types.ts"
  },
  "cacheDirectories": [
    ".next/cache"
  ],
  "pre-commit": [
    "lint"
  ],
  "pkg": {
    "assets": [
      "src/assets/**/*",
      "public/**/*"
    ]
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "nyc": {
    "all": true,
    "include": "src/**"
  },
  "dependencies": {
    "@faker-js/faker": "^7.5.0",
    "@headlessui/react": "^1.7.19",
    "@heroicons/react": "^1.0.6",
    "@hookform/resolvers": "^5.2.1",
    "@paypal/checkout-server-sdk": "^1.0.3",
    "@paypal/react-paypal-js": "^7.8.1",
    "@prisma/client": "^6.14.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@reduxjs/toolkit": "^1.8.5",
    "@stripe/react-stripe-js": "^1.10.0",
    "@stripe/stripe-js": "^1.36.0",
    "@tanstack/react-table": "^8.21.3",
    "@types/react-beautiful-dnd": "^13.1.8",
    "@vercel/blob": "^1.1.1",
    "apexcharts": "^3.35.5",
    "axios": "^0.27.2",
    "axios-retry": "^3.3.1",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "copy-webpack-plugin": "^11.0.0",
    "csv-parse": "^6.1.0",
    "currency-symbol-map": "^5.1.0",
    "date-fns": "2.30.0",
    "date-fns-tz": "2.0.0",
    "dompurify": "^3.2.7",
    "dotenv": "^17.2.1",
    "draft-convert": "^2.1.13",
    "draft-js": "^0.11.7",
    "ejs": "^3.1.8",
    "fast-xml-parser": "^4.0.9",
    "file-type": "^21.0.0",
    "form-data": "^4.0.4",
    "formidable": "^2.0.1",
    "formik": "^2.2.9",
    "framer-motion": "^6.3.11",
    "google-auth-library": "^8.5.2",
    "html-to-text": "^9.0.5",
    "i18n-iso-countries": "^7.5.0",
    "ical-generator": "^3.5.2",
    "json-2-csv": "^3.17.1",
    "jsonwebtoken": "^8.5.1",
    "lucide-react": "^0.540.0",
    "mailgun.js": "^12.0.3",
    "next": "^12.3.0",
    "next-absolute-url": "^1.2.2",
    "next-auth": "^4.10.3",
    "next-translate": "^1.6.0",
    "pdf-lib": "^1.17.1",
    "pdf-merger-js": "^5.1.2",
    "pg": "^8.16.3",
    "ps-node-promise-es6": "^0.0.1",
    "puppeteer": "^19.8.2",
    "qrcode": "^1.5.1",
    "react": "18.2.0",
    "react-apexcharts": "^1.4.0",
    "react-beautiful-dnd": "^13.1.1",
    "react-colorful": "^5.6.1",
    "react-day-picker": "^9.9.0",
    "react-dom": "18.2.0",
    "react-draft-wysiwyg": "^1.15.0",
    "react-flag-kit": "^1.1.1",
    "react-hook-form": "^7.62.0",
    "react-json-view": "^1.21.3",
    "react-parallax-tilt": "^1.7.63",
    "react-qr-reader": "^3.0.0-beta-1",
    "react-quill": "^2.0.0",
    "react-redux": "^8.0.2",
    "react-zoom-pan-pinch": "^2.1.3",
    "request-ip": "^3.3.0",
    "rrule": "^2.8.1",
    "sass": "^1.54.9",
    "simplebar-react": "^2.4.1",
    "sonner": "^2.0.7",
    "stripe": "^10.17.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^9.0.0",
    "webpack-bundle-analyzer": "^4.6.1",
    "yup": "^0.32.11",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@cypress/code-coverage": "^3.10.0",
    "@cypress/react": "6.2.0",
    "@cypress/webpack-dev-server": "^2.3.0",
    "@tailwindcss/forms": "^0.5.10",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/dompurify": "^3.0.5",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^8.5.9",
    "@types/node": "^18.7.18",
    "@types/react": "18.2.46",
    "@types/react-dom": "18.2.18",
    "@types/react-redux": "^7.1.24",
    "autoprefixer": "^10.4.21",
    "babel-loader": "^8.2.5",
    "babel-plugin-istanbul": "^6.1.1",
    "chai-colors": "^1.0.1",
    "copyfiles": "^2.4.1",
    "cross-env": "^7.0.3",
    "cypress": "^10.7.0",
    "cypress-real-events": "^1.7.1",
    "eslint": "8.23.1",
    "eslint-config-next": "^12.3.0",
    "glob": "^11.0.3",
    "html-webpack-plugin": "^5.5.0",
    "jest": "^30.1.3",
    "ngrok": "^4.3.3",
    "node-mocks-http": "^1.17.2",
    "postcss": "^8.5.6",
    "pre-commit": "^1.2.2",
    "prettier": "2.7.1",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "prisma": "^6.14.0",
    "smtp-tester": "^2.0.0",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.1",
    "typescript": "^5.4.5",
    "webpack": "^5.74.0",
    "webpack-dev-server": "^4.11.0"
  }
}
