# JVS Tickets Blob Storage Configuration
# Store: jvs-tickets-blob
# Store ID: store_htOOSyXCaVVsUYJz
# Region: London, United Kingdom (LHR1)
# Base URL: https://htoosyxcavvsuyjz.public.blob.vercel-storage.com

# Required: Your database connection string
DATABASE_URL=postgres://username:password@host:port/database

# Required: Your Vercel Blob Storage read/write token
# Get this from: Vercel Dashboard → Storage → jvs-tickets-blob → Tokens
BLOB_READ_WRITE_TOKEN=your_token_here

# Your specific blob storage configuration
BLOB_PREFIX=events/cover-images
BLOB_PUBLIC_BASE=https://htoosyxcavvsuyjz.public.blob.vercel-storage.com

# Migration settings (adjust as needed)
# LIMIT=50           # Process only 50 events for testing
# CONCURRENCY=6      # Number of concurrent uploads
# DRY_RUN=1          # Test mode (no actual uploads or DB changes)
