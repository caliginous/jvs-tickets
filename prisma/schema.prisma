generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id             Int                  @id @default(autoincrement())
  title          String
  seatType       String
  seatMapId      Int?
  coverImage     String?
  coverImageSize Int?
  personalTicket Boolean              @default(false)
  venueId        Int?
  description    String?
  bespokeMessage String?
  isActive       Boolean              @default(true)
  slug           String?              @unique
  categories     CategoriesOnEvents[]
  customFields   CustomField[]
  seatMap        SeatMap?             @relation(fields: [seatMapId], references: [id])
  venue          Venue?               @relation(fields: [venueId], references: [id])
  dates          EventDate[]
  ticketTypes    EventTicketType[]
}

model EventTicketType {
  id              Int         @id @default(autoincrement())
  eventId         Int
  name            String
  description     String?
  price           Int
  currency        String      @default("GBP")
  capacity        Int?
  sold            Int         @default(0)
  isActive        Boolean     @default(true)
  sortOrder       Int         @default(0)
  colorHex        String?
  isPublic        Boolean     @default(true)
  publicSortOrder Int         @default(0)
  stripeProductId String?
  stripePriceId   String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  event           Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orderItems      OrderItem[]
  tickets         Ticket[]

  @@unique([eventId, name])
  @@index([eventId])
  @@index([isPublic, isActive])
}

model EventDate {
  id                  Int               @id @default(autoincrement())
  title               String?
  eventId             Int
  date                DateTime?
  totalTicketLimit    Int?
  ticketSaleStartDate DateTime?
  ticketSaleEndDate   DateTime?
  event               Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orders              Order[]
  seatReservations    SeatReservation[]
}

model CustomField {
  id         Int     @id @default(autoincrement())
  label      String
  name       String
  isRequired Boolean
  eventId    Int
  event      Event   @relation(fields: [eventId], references: [id])
}

model SeatMap {
  id          Int     @id @default(autoincrement())
  definition  String
  preview     Bytes?
  previewType String?
  events      Event[]
  orders      Order[]
}

model Category {
  id            Int                  @id @default(autoincrement())
  label         String
  price         Float
  color         String?
  activeColor   String?
  occupiedColor String?
  events        CategoriesOnEvents[]
  tickets       Ticket[]
}

model CategoriesOnEvents {
  eventId    Int
  categoryId Int
  maxAmount  Int?
  category   Category @relation(fields: [categoryId], references: [id])
  event      Event    @relation(fields: [eventId], references: [id])

  @@id([eventId, categoryId])
}

model User {
  id           String  @id @default(uuid())
  firstName    String
  lastName     String
  email        String  @unique
  address      String
  zip          String
  city         String
  countryCode  String
  regionCode   String
  customFields String?
  phone        String?
  orders       Order[]
}

model Order {
  id                 String        @id @default(uuid())
  userId             String
  paymentType        String
  paymentIntent      String?
  paymentResult      String?
  status             String        @default("PENDING")
  seatMapId          Int?
  eventDateId        Int
  shipping           String
  locale             String
  invoiceSent        Boolean       @default(false)
  date               DateTime      @default(now())
  idempotencyKey     String        @unique
  cancellationSecret String
  invoiceNumber      Int?
  discountCodeId     String?
  discountAmount     Float         @default(0)
  originalTotal      Float?
  finalTotal         Float?
  cancellationReason String?
  cancelledAt        DateTime?
  cancelledBy        String?
  refundAmount       Float?
  refundId           String?
  refundedAt         DateTime?
  customFields       String?       // JSON string of custom field responses for this order
  discountCode       DiscountCode? @relation(fields: [discountCodeId], references: [id])
  eventDate          EventDate     @relation(fields: [eventDateId], references: [id], onDelete: Cascade)
  seatMap            SeatMap?      @relation(fields: [seatMapId], references: [id])
  user               User          @relation(fields: [userId], references: [id])
  orderItems         OrderItem[]
  task               Task?
  tickets            Ticket[]

  @@index([date])
  @@index([eventDateId])
  @@index([shipping])
  @@index([status])
  @@index([cancelledAt])
  @@index([refundId])
}

model OrderItem {
  id                Int             @id @default(autoincrement())
  orderId           String
  eventTicketTypeId Int
  quantity          Int
  unitPrice         Int
  currency          String          @default("GBP")
  eventTicketType   EventTicketType @relation(fields: [eventTicketTypeId], references: [id])
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([eventTicketTypeId])
}

model SeatReservation {
  id            String    @id @default(uuid())
  reservationId String
  seatId        Int?
  categoryId    Int
  amount        Int       @default(1)
  expiresAt     DateTime
  eventDateId   Int
  eventDate     EventDate @relation(fields: [eventDateId], references: [id], onDelete: Cascade)
}

model Ticket {
  id                String           @id @default(uuid())
  orderId           String
  used              Boolean          @default(false)
  seatId            Int?
  secret            String?
  categoryId        Int?
  amount            Int              @default(1)
  firstName         String?
  lastName          String?
  currency          String           @default("GBP")
  eventTicketTypeId Int?
  feeCharged        Int              @default(0)
  priceCharged      Int?
  taxCharged        Int              @default(0)
  category          Category?        @relation(fields: [categoryId], references: [id])
  eventTicketType   EventTicketType? @relation(fields: [eventTicketTypeId], references: [id])
  order             Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([categoryId])
  @@index([eventTicketTypeId])
  @@index([secret])
  @@index([used])
}

model AdminUser {
  id                   Int             @id @default(autoincrement())
  userName             String          @unique
  email                String          @unique
  password             String
  readRights           String
  writeRights          String
  apiKeys              AdminApiKeys[]
  discountCodes        DiscountCode[]
  emailSettingsUpdated EmailSettings[]
  templatesCreated     EmailTemplate[] @relation("TemplateCreatedBy")
  templatesUpdated     EmailTemplate[] @relation("TemplateUpdatedBy")
  emailTests           EmailTest[]
  notifications        Notification[]
  tasks                Task[]
  venues               Venue[]
}

model AdminApiKeys {
  id     Int       @id @default(autoincrement())
  key    String    @unique
  userId Int
  name   String
  user   AdminUser @relation(fields: [userId], references: [id])
}

model Option {
  key   String @unique
  value String
  data  Bytes?
}

model Translation {
  id           Int    @id @default(autoincrement())
  key          String
  namespace    String
  translations String
}

model Notification {
  id     Int       @id @default(autoincrement())
  userId Int
  data   String?
  type   String
  user   AdminUser @relation(fields: [userId], references: [id])
}

model Task {
  id           Int        @id @default(autoincrement())
  orderId      String     @unique
  adminUserId  Int?
  notes        String
  assignedUser AdminUser? @relation(fields: [adminUserId], references: [id])
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model DiscountCode {
  id                  String    @id @default(uuid())
  code                String    @unique
  description         String?
  discountType        String
  discountValue       Float
  validFrom           DateTime  @default(now())
  validUntil          DateTime?
  usageLimit          Int?
  currentUsage        Int       @default(0)
  isActive            Boolean   @default(true)
  appliesToEvents     String[]
  appliesToCategories String[]
  minimumOrderValue   Float?
  maximumDiscount     Float?
  createdById         Int
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  createdBy           AdminUser @relation(fields: [createdById], references: [id])
  orders              Order[]
}

model Venue {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  address     String?
  city        String?
  postcode    String?
  description String?
  isActive    Boolean   @default(true)
  createdById Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  events      Event[]
  createdBy   AdminUser @relation(fields: [createdById], references: [id])
}

model EmailSettings {
  id               String     @id @default(uuid())
  transportMode    String
  smtpHost         String?
  smtpPort         Int?
  smtpSecure       Boolean    @default(false)
  smtpUser         String?
  smtpPassword     String?
  providerName     String?
  providerUser     String?
  providerPassword String?
  senderEmail      String
  senderName       String?
  bccEmail         String?
  appBaseUrl       String
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  updatedBy        Int?
  updatedByUser    AdminUser? @relation(fields: [updatedBy], references: [id])

  @@index([transportMode])
}

model EmailTemplate {
  id            String      @id @default(uuid())
  name          String
  mailType      String
  subjects      Json
  baseHtml      String
  bodyHtml      String?
  samplePayload Json?
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  createdBy     Int?
  updatedBy     Int?
  emailLogs     EmailLog[]
  createdByUser AdminUser?  @relation("TemplateCreatedBy", fields: [createdBy], references: [id])
  updatedByUser AdminUser?  @relation("TemplateUpdatedBy", fields: [updatedBy], references: [id])
  emailTests    EmailTest[]

  @@index([mailType])
  @@index([isActive])
}

model EmailLog {
  id             String         @id @default(uuid())
  templateId     String?
  recipientEmail String
  subject        String
  htmlContent    String
  messageId      String?
  status         String
  errorMessage   String?
  mailType       String?
  locale         String         @default("en")
  payload        Json?
  sentAt         DateTime       @default(now())
  deliveredAt    DateTime?
  template       EmailTemplate? @relation(fields: [templateId], references: [id])

  @@index([status])
  @@index([sentAt])
  @@index([mailType])
}

model EmailTest {
  id           String         @id @default(uuid())
  templateId   String?
  testEmail    String
  testPayload  Json?
  locale       String         @default("en")
  success      Boolean
  messageId    String?
  errorMessage String?
  testedAt     DateTime       @default(now())
  testedBy     Int?
  template     EmailTemplate? @relation(fields: [templateId], references: [id])
  testedByUser AdminUser?     @relation(fields: [testedBy], references: [id])

  @@index([success])
  @@index([testedAt])
}
